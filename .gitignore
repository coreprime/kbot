# Binaries
# Compiled `cmd/*` outputs land at the repo root when built without -o
# (e.g. `go build ./cmd/...`); ignore each by name.
/bin/
/kbot

# Build artifacts
coverage.out
coverage.html
*.exe
*.dll
*.so
*.dylib

# WASM engine build outputs (generated by `task build-wasm`)
internal/studio/web/engine/engine.wasm
internal/studio/web/engine/wasm_exec.js

# Go
vendor/
*.test

# Cache
.cache/

# Environment overrides
.env.local

# Node
/node_modules/
internal/studio/web/node_modules/

# Vite build output (embedded into the Go binary by `task build`).
# Keep the committed .gitkeep so the Go package embedding dist/ still
# compiles on a fresh checkout before the web bundle has been built.
internal/studio/web/dist/*
!internal/studio/web/dist/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Game Assets from Local Workspace
flat

# Local Files
.claude
.local

# Consume-proof example (installs the published package; nothing to commit)
examples/*/node_modules/
examples/*/package-lock.json
